# Copy to `.env.local` or `.env` before starting `node server.js`.
# Existing shell env vars still take precedence over this file.

# OnlyOffice Document Server URL
ONLYOFFICE_SERVER_URL=http://127.0.0.1:8081

# Public base URL that the Document Server can call back to.
# If Document Server runs in Docker and this app runs on the host,
# replace with an address reachable from the container, such as:
# http://host.docker.internal:8080
ONLYOFFICE_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Public base URL used in invite emails and notification emails.
# In production, replace with the externally reachable address, such as:
# https://cde.example.com
CDE_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Optional JWT secret when token validation is enabled in OnlyOffice.
ONLYOFFICE_JWT_SECRET=

# Temporary source-file URL lifetime for OnlyOffice Document Server callbacks.
# Default in code: 12 hours.
ONLYOFFICE_DOCUMENT_URL_TTL_MS=43200000

# Autodesk Platform Services (APS) Viewer
# Used for DWG / NWD / NWC / RVT / IFC model rendering and review workspace.
# The local server will also auto-upload model files to APS OSS and trigger
# Model Derivative translation after each upload / new version.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_BUCKET_KEY=
APS_BUCKET_POLICY=persistent
APS_BUCKET_REGION=US

# Viewer CDN version. `7.*` tracks the latest v7 build.
APS_VIEWER_VERSION=7.*

# Viewer runtime environment. The defaults below align with the current APS Viewer setup.
APS_VIEWER_ENV=AutodeskProduction2
APS_VIEWER_API=streamingV2

# Optional CRS AI summary service
# When configured, workflow reports can call this endpoint to generate CRS drafts.
# If omitted, the app falls back to the built-in heuristic summarizer.
CDE_CRS_AI_ENDPOINT=
CDE_CRS_AI_API_KEY=
CDE_CRS_AI_MODEL=
CDE_CRS_AI_TIMEOUT_MS=20000
CDE_CRS_AI_BATCH_SIZE=100

# Production hardening
CDE_BOOTSTRAP_PASSWORD=
CDE_AUDIT_LOG_RETENTION_LIMIT=5000
CDE_MAX_UPLOAD_BYTES=104857600
CDE_MAX_ATTACHMENT_BYTES=26214400
CDE_ATTACHMENT_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.csv,.ppt,.pptx,.png,.jpg,.jpeg,.gif,.webp,.txt,.zip
CDE_ATTACHMENT_BLOCKED_EXTENSIONS=.exe,.dll,.bat,.cmd,.sh,.ps1,.js,.mjs,.vbs,.jar,.app,.dmg
CDE_BACKUP_DIR=./data/backups

# SMTP mail delivery
CDE_SMTP_HOST=
CDE_SMTP_PORT=587
CDE_SMTP_ENCRYPTION=starttls
CDE_SMTP_AUTH_REQUIRED=true
CDE_SMTP_USERNAME=
CDE_SMTP_PASSWORD=
CDE_SMTP_SENDER_NAME=CDE文件管理系统
CDE_SMTP_SENDER_EMAIL=system@example.com
CDE_SMTP_REPLY_TO=
CDE_SMTP_SUBJECT_PREFIX=[CDE]

# S3 / MinIO storage
CDE_STORAGE_ADAPTER=local
CDE_S3_BUCKET=
CDE_S3_PREFIX=cde-docs
CDE_S3_ENDPOINT=
CDE_S3_REGION=us-east-1
CDE_S3_FORCE_PATH_STYLE=true
CDE_S3_MULTIPART_PART_SIZE=8388608
CDE_S3_MULTIPART_QUEUE_SIZE=4
CDE_S3_RETRY_ATTEMPTS=3
CDE_S3_RETRY_BASE_DELAY_MS=150

# Required when using docker-compose with bundled MinIO.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
